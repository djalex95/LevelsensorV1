   1:Core/Inc/sensor_scale.h **** /*
   2:Core/Inc/sensor_scale.h ****  * sensor_scale.h
   3:Core/Inc/sensor_scale.h ****  *
   4:Core/Inc/sensor_scale.h ****  * Umrechnung Rohwert -> physikalische Groesse, getrennt vom I2C-Zugriff.
   5:Core/Inc/sensor_scale.h ****  * Bewusst frei von HAL-Abhaengigkeiten, damit die Skalierung auf dem PC
   6:Core/Inc/sensor_scale.h ****  * getestet werden kann (tests/test_sensor_conv.c). Die messbereichs-
   7:Core/Inc/sensor_scale.h ****  * abhaengigen Zahlen kommen aus der Variante (sensor_cfg.h).
   8:Core/Inc/sensor_scale.h ****  *
   9:Core/Inc/sensor_scale.h ****  * Einheiten wie bisher:
  10:Core/Inc/sensor_scale.h ****  *   Druck       in uBar     (1 uBar = 0,1 Pa)
  11:Core/Inc/sensor_scale.h ****  *   Temperatur  in 0,01 Grad C
  12:Core/Inc/sensor_scale.h ****  *
  13:Core/Inc/sensor_scale.h ****  * Alles in Ganzzahlarithmetik - der Cortex-M0+ hat keine FPU, jede
  14:Core/Inc/sensor_scale.h ****  * Fliesskommarechnung zoege die Soft-Float-Bibliothek in den Flash.
  15:Core/Inc/sensor_scale.h ****  */
  16:Core/Inc/sensor_scale.h **** #ifndef INC_SENSOR_SCALE_H_
  17:Core/Inc/sensor_scale.h **** #define INC_SENSOR_SCALE_H_
  18:Core/Inc/sensor_scale.h **** 
  19:Core/Inc/sensor_scale.h **** #include <stdint.h>
  20:Core/Inc/sensor_scale.h **** #include "sensor_cfg.h"
  21:Core/Inc/sensor_scale.h **** 
  22:Core/Inc/sensor_scale.h **** #if SENSOR_KIND == SENSOR_KIND_PDMS
  23:Core/Inc/sensor_scale.h **** 
  24:Core/Inc/sensor_scale.h **** /* --- Wuerth WSEN-PDMS -------------------------------------------------
  25:Core/Inc/sensor_scale.h ****  *
  26:Core/Inc/sensor_scale.h ****  * Handbuch (UM_WSEN-PDMS, rev 1.0), bidirektionale Typen (+/-1, +/-10,
  27:Core/Inc/sensor_scale.h ****  * +/-35 kPa):
ARM GAS  C:\Users\a_hae\AppData\Local\Temp\cc4mSm3y.s 			page 2


  28:Core/Inc/sensor_scale.h ****  *
  29:Core/Inc/sensor_scale.h ****  *   Druck [kPa]      = (P16 - OUTP_MIN) * SENP + PMIN
  30:Core/Inc/sensor_scale.h ****  *   Temperatur [GrdC]= (T16 - OUTT_MIN) * SENT
  31:Core/Inc/sensor_scale.h ****  *
  32:Core/Inc/sensor_scale.h ****  * mit OUTP_MIN = 3277, OUTP_MAX = 29491, OUTT_MIN = 8192 und
  33:Core/Inc/sensor_scale.h ****  * SENT = 4,272e-3 GrdC/digit.
  34:Core/Inc/sensor_scale.h ****  *
  35:Core/Inc/sensor_scale.h ****  * Wir rechnen die Druckformel um die Bereichsmitte herum, weil das
  36:Core/Inc/sensor_scale.h ****  * Ergebnis identisch ist, aber ohne 64-Bit-Multiplikation auskommt:
  37:Core/Inc/sensor_scale.h ****  *
  38:Core/Inc/sensor_scale.h ****  *   Mitte  = (OUTP_MIN + OUTP_MAX) / 2 = 16384  -> 0 kPa
  39:Core/Inc/sensor_scale.h ****  *   Halbe Spanne = (OUTP_MAX - OUTP_MIN) / 2 = 13107
  40:Core/Inc/sensor_scale.h ****  *   Druck [uBar] = (P16 - 16384) * FS_UBAR / 13107
  41:Core/Inc/sensor_scale.h ****  *
  42:Core/Inc/sensor_scale.h ****  * Probe: P16 = 3277 -> -FS_UBAR, P16 = 29491 -> +FS_UBAR.
  43:Core/Inc/sensor_scale.h ****  * Die direkte Form (P16 - 3277) * 2*FS_UBAR / 26214 wuerde beim
  44:Core/Inc/sensor_scale.h ****  * +/-10-kPa-Typ mit 26214 * 200000 = 5,2e9 den int32 sprengen.
  45:Core/Inc/sensor_scale.h ****  */
  46:Core/Inc/sensor_scale.h **** #define SENSOR_OUT_MIN        3277
  47:Core/Inc/sensor_scale.h **** #define SENSOR_OUT_MAX        29491
  48:Core/Inc/sensor_scale.h **** #define SENSOR_OUT_MID        16384      /* Rohwert bei 0 kPa            */
  49:Core/Inc/sensor_scale.h **** #define SENSOR_OUT_HALFSPAN   13107      /* Rohwerte je Richtung         */
  50:Core/Inc/sensor_scale.h **** #define SENSOR_OUTT_MIN       8192       /* Rohwert bei 0 Grad C         */
  51:Core/Inc/sensor_scale.h **** 
  52:Core/Inc/sensor_scale.h **** /* Rohwert -> Druck in uBar. Der Rohwert wird auf den gueltigen Bereich
  53:Core/Inc/sensor_scale.h ****  * begrenzt: das haelt die Multiplikation im int32 und liefert bei
  54:Core/Inc/sensor_scale.h ****  * Ueberlast einen sauber gesaettigten Wert statt eines Ueberlaufs. */
  55:Core/Inc/sensor_scale.h **** static inline int32_t sensor_raw_to_ubar(uint16_t p16)
  56:Core/Inc/sensor_scale.h **** {
  57:Core/Inc/sensor_scale.h **** 	int32_t p = (int32_t)p16;
  58:Core/Inc/sensor_scale.h **** 
  59:Core/Inc/sensor_scale.h **** 	if (p < SENSOR_OUT_MIN)
  60:Core/Inc/sensor_scale.h **** 	{
  61:Core/Inc/sensor_scale.h **** 		p = SENSOR_OUT_MIN;
  62:Core/Inc/sensor_scale.h **** 	}
  63:Core/Inc/sensor_scale.h **** 	else if (p > SENSOR_OUT_MAX)
  64:Core/Inc/sensor_scale.h **** 	{
  65:Core/Inc/sensor_scale.h **** 		p = SENSOR_OUT_MAX;
  66:Core/Inc/sensor_scale.h **** 	}
  67:Core/Inc/sensor_scale.h **** 
  68:Core/Inc/sensor_scale.h **** 	return ((p - SENSOR_OUT_MID) * SENSOR_FS_UBAR) / SENSOR_OUT_HALFSPAN;
  69:Core/Inc/sensor_scale.h **** }
  70:Core/Inc/sensor_scale.h **** 
  71:Core/Inc/sensor_scale.h **** /* 1, wenn der Rohwert ausserhalb des spezifizierten Bereichs lag (der
  72:Core/Inc/sensor_scale.h ****  * Messwert ist dann gesaettigt und nicht mehr vertrauenswuerdig). */
  73:Core/Inc/sensor_scale.h **** static inline uint8_t sensor_raw_saturated(uint16_t p16)
  74:Core/Inc/sensor_scale.h **** {
  75:Core/Inc/sensor_scale.h **** 	return (uint8_t)((p16 < SENSOR_OUT_MIN) || (p16 > SENSOR_OUT_MAX));
  76:Core/Inc/sensor_scale.h **** }
  77:Core/Inc/sensor_scale.h **** 
  78:Core/Inc/sensor_scale.h **** /* Rohwert -> Temperatur in 0,01 Grad C.
  79:Core/Inc/sensor_scale.h ****  * SENT = 4,272e-3 GrdC/digit -> in 0,01 GrdC: * 0,4272 = * 267/625
  80:Core/Inc/sensor_scale.h ****  * (der Bruch ist exakt, 4272/10000 gekuerzt).
  81:Core/Inc/sensor_scale.h ****  * Probe: T16 = 24576 -> 6999, also 69,99 GrdC (Datenblatt: 70 GrdC). */
  82:Core/Inc/sensor_scale.h **** static inline int16_t sensor_raw_to_temp(uint16_t t16)
  83:Core/Inc/sensor_scale.h **** {
  84:Core/Inc/sensor_scale.h **** 	return (int16_t)((((int32_t)t16 - SENSOR_OUTT_MIN) * 267) / 625);
ARM GAS  C:\Users\a_hae\AppData\Local\Temp\cc4mSm3y.s 			page 3


  85:Core/Inc/sensor_scale.h **** }
  86:Core/Inc/sensor_scale.h **** 
  87:Core/Inc/sensor_scale.h **** #elif SENSOR_KIND == SENSOR_KIND_LEGACY
  88:Core/Inc/sensor_scale.h **** 
  89:Core/Inc/sensor_scale.h **** /* --- Alter 24-Bit-Drucksensor ----------------------------------------
  90:Core/Inc/sensor_scale.h ****  *
  91:Core/Inc/sensor_scale.h ****  * Druck: raw / k mit k = 12,8 (40-kPa-Typ) -> raw * 10 / 128.
  92:Core/Inc/sensor_scale.h ****  *        (20-kPa-Typ waere k = 25,6 -> raw * 10 / 256.)
  93:Core/Inc/sensor_scale.h ****  * Temperatur: raw / 256 Grad C -> in 0,01 Grad C: raw * 100 / 256
  94:Core/Inc/sensor_scale.h ****  *        = raw * 25 / 64.
  95:Core/Inc/sensor_scale.h ****  *
  96:Core/Inc/sensor_scale.h ****  * Der Wertebereich von raw24 ist +/-8388608; mal 10 sind das hoechstens
  97:Core/Inc/sensor_scale.h ****  * 8,4e7 und damit sicher im int32. Die frueher benutzte int64-Rechnung
  98:Core/Inc/sensor_scale.h ****  * war fuer jeden moeglichen Eingabewert identisch, kostete aber einen
  99:Core/Inc/sensor_scale.h ****  * Aufruf der 64-Bit-Divisionsroutine.
 100:Core/Inc/sensor_scale.h ****  */
