   1:Core/Src/board_pins.c **** /*
   2:Core/Src/board_pins.c ****  * board_pins.c - Beschreibung und Begruendung siehe board_pins.h
   3:Core/Src/board_pins.c ****  */
   4:Core/Src/board_pins.c **** 
   5:Core/Src/board_pins.c **** #include "board_pins.h"
   6:Core/Src/board_pins.c **** #include "main.h"
   7:Core/Src/board_pins.c **** #include "sensor_cfg.h"		/* liefert HW_VARIANT und prueft es gegen den Include-Pfad */
   8:Core/Src/board_pins.c **** 
   9:Core/Src/board_pins.c **** #if HW_VARIANT == 1000
  10:Core/Src/board_pins.c **** 
  11:Core/Src/board_pins.c **** /* ---------------- Platine V1 (STM32G0B1KBU6N) ---------------- */
  12:Core/Src/board_pins.c **** 
  13:Core/Src/board_pins.c **** void board_fdcan_pins_init(void)
  14:Core/Src/board_pins.c **** {
  15:Core/Src/board_pins.c **** 	GPIO_InitTypeDef GPIO_InitStruct = {0};
  16:Core/Src/board_pins.c **** 
  17:Core/Src/board_pins.c **** 	/* Erst die von CubeMX gesetzten V2-Pins wieder loesen. Ohne das waeren
  18:Core/Src/board_pins.c **** 	 * PA11 und PD0 gleichzeitig auf FDCAN1_RX gemuxt. PA11 haengt auf der
  19:Core/Src/board_pins.c **** 	 * V1-Platine an keinem Netz (die Loetbruecken zu den CAN-Leitungen sind
  20:Core/Src/board_pins.c **** 	 * offen), der Eingang wuerde also frei floaten und den Empfang stoeren. */
  21:Core/Src/board_pins.c **** 	HAL_GPIO_DeInit(GPIOA, GPIO_PIN_11 | GPIO_PIN_12);
  22:Core/Src/board_pins.c **** 
  23:Core/Src/board_pins.c **** 	__HAL_RCC_GPIOD_CLK_ENABLE();
  24:Core/Src/board_pins.c **** 
  25:Core/Src/board_pins.c **** 	/* PD0 -> FDCAN1_RX, PD1 -> FDCAN1_TX; gleiche Alternate Function wie
  26:Core/Src/board_pins.c **** 	 * auf PA11/PA12, es aendern sich nur Port und Pinmaske. */
  27:Core/Src/board_pins.c **** 	GPIO_InitStruct.Pin = GPIO_PIN_0 | GPIO_PIN_1;
ARM GAS  C:\Users\a_hae\AppData\Local\Temp\ccA7PVuG.s 			page 2


  28:Core/Src/board_pins.c **** 	GPIO_InitStruct.Mode = GPIO_MODE_AF_PP;
  29:Core/Src/board_pins.c **** 	GPIO_InitStruct.Pull = GPIO_NOPULL;
  30:Core/Src/board_pins.c **** 	GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
  31:Core/Src/board_pins.c **** 	GPIO_InitStruct.Alternate = GPIO_AF3_FDCAN1;
  32:Core/Src/board_pins.c **** 	HAL_GPIO_Init(GPIOD, &GPIO_InitStruct);
  33:Core/Src/board_pins.c **** }
  34:Core/Src/board_pins.c **** 
  35:Core/Src/board_pins.c **** void board_gpio_fixup(void)
  36:Core/Src/board_pins.c **** {
  37:Core/Src/board_pins.c **** 	GPIO_InitTypeDef GPIO_InitStruct = {0};
  38:Core/Src/board_pins.c **** 
  39:Core/Src/board_pins.c **** 	__HAL_RCC_GPIOD_CLK_ENABLE();
  40:Core/Src/board_pins.c **** 
  41:Core/Src/board_pins.c **** 	/* CAN_STBY liegt auf PD2 statt auf PB4, mit demselben Startpegel wie in
  42:Core/Src/board_pins.c **** 	 * der generierten Init: LOW = Transceiver aktiv. Der Pin wird im Betrieb
  43:Core/Src/board_pins.c **** 	 * nirgends umgeschaltet, deshalb genuegt diese einmalige Konfiguration
  44:Core/Src/board_pins.c **** 	 * und es braucht keine Makro-Indirektion im uebrigen Code. */
  45:Core/Src/board_pins.c **** 	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_2, GPIO_PIN_RESET);
  46:Core/Src/board_pins.c **** 
  47:Core/Src/board_pins.c **** 	GPIO_InitStruct.Pin = GPIO_PIN_2;
  48:Core/Src/board_pins.c **** 	GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  49:Core/Src/board_pins.c **** 	GPIO_InitStruct.Pull = GPIO_NOPULL;
  50:Core/Src/board_pins.c **** 	GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
  51:Core/Src/board_pins.c **** 	HAL_GPIO_Init(GPIOD, &GPIO_InitStruct);
  52:Core/Src/board_pins.c **** }
