   1:Core/Inc/hw_otp.h **** /*
   2:Core/Inc/hw_otp.h ****  * hw_otp.h - Hardware-Kennung im OTP-Bereich (Issue #2)
   3:Core/Inc/hw_otp.h ****  *
   4:Core/Inc/hw_otp.h ****  * Die Hardware-Variante (z. B. 1003) und der Platinen-Buchstabe ("A")
   5:Core/Inc/hw_otp.h ****  * werden bei der Produktion in den OTP-Bereich des STM32G0B1 geschrieben
   6:Core/Inc/hw_otp.h ****  * und sind damit eine Eigenschaft des Geraets statt einer Behauptung der
   7:Core/Inc/hw_otp.h ****  * Firmware. Gemeinsame Definition fuer App-Firmware und Bootloader; das
   8:Core/Inc/hw_otp.h ****  * Provisionierungs-Tool (LevelSense_Bootloader, tools/provision/) haelt
   9:Core/Inc/hw_otp.h ****  * eine dokumentierte Kopie dieser Konstanten.
  10:Core/Inc/hw_otp.h ****  *
  11:Core/Inc/hw_otp.h ****  * OTP: 1 KB ab 0x1FFF7000, nur 64-Bit-Doppelworte, jedes Doppelwort
  12:Core/Inc/hw_otp.h ****  * wegen der Flash-ECC nur EINMAL beschreibbar - auch das Nachschreiben
  13:Core/Inc/hw_otp.h ****  * desselben Werts ist verboten. Deshalb eine Slot-Liste statt eines
  14:Core/Inc/hw_otp.h ****  * Einzelwerts: eine Korrektur ist ein neuer Slot dahinter, es gilt
  15:Core/Inc/hw_otp.h ****  * immer der letzte gueltige Eintrag.
  16:Core/Inc/hw_otp.h ****  */
  17:Core/Inc/hw_otp.h **** #ifndef INC_HW_OTP_H_
  18:Core/Inc/hw_otp.h **** #define INC_HW_OTP_H_
  19:Core/Inc/hw_otp.h **** 
  20:Core/Inc/hw_otp.h **** #include <stdint.h>
  21:Core/Inc/hw_otp.h **** #include <stddef.h>
  22:Core/Inc/hw_otp.h **** 
  23:Core/Inc/hw_otp.h **** #define HW_OTP_ADDR    0x1FFF7000UL   /* OTP-Basis STM32G0B1 */
  24:Core/Inc/hw_otp.h **** #define HW_OTP_SLOTS   16             /* 16 x 8 Byte = 128 Byte reserviert */
  25:Core/Inc/hw_otp.h **** #define HW_OTP_MAGIC   0x4857U        /* "HW" */
  26:Core/Inc/hw_otp.h **** 
  27:Core/Inc/hw_otp.h **** typedef struct {
ARM GAS  C:\Users\a_hae\AppData\Local\Temp\cci8zHTh.s 			page 2


  28:Core/Inc/hw_otp.h **** 	uint16_t magic;     /* HW_OTP_MAGIC */
  29:Core/Inc/hw_otp.h **** 	uint16_t variant;   /* 1001, 1003, ... */
  30:Core/Inc/hw_otp.h **** 	uint8_t  rev;       /* Platinen-Buchstabe, ASCII 'A'..'Z' */
  31:Core/Inc/hw_otp.h **** 	uint8_t  check;     /* hw_otp_checksum() */
  32:Core/Inc/hw_otp.h **** 	uint16_t reserved;  /* beim Schreiben 0x0000 */
  33:Core/Inc/hw_otp.h **** } hw_otp_slot_t;
  34:Core/Inc/hw_otp.h **** 
